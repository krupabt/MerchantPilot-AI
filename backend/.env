# MerchantPilot AI — Backend Environment Configuration
# -------------------------------------------------------
# STEP 1: Go to https://dashboard.razorpay.com/app/keys
# STEP 2: Switch to TEST MODE (toggle top-right)
# STEP 3: Generate Test API Keys
# STEP 4: Paste Key ID and Key Secret below

APP_NAME="MerchantPilot AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

DATABASE_URL="sqlite:///./merchantpilot.db"

# --- RAZORPAY TEST MODE KEYS (replace with your actual test keys) ---
RAZORPAY_KEY_ID="rzp_test_TYEq23sx66rBBW"
RAZORPAY_KEY_SECRET="r5onU6BdXEtdAXZCnt7lkRW5"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_YOUR_WEBHOOK_SECRET"

# Gemini AI (optional — fallback agent works without it)
GEMINI_API_KEY=""

# Merchant Policy Defaults
DEFAULT_MAX_DISCOUNT_PERCENTAGE=10.0
DEFAULT_MAX_DISCOUNT_AMOUNT=6000.0
DEFAULT_MAX_TRANSACTION_AMOUNT=100000.0
