# MerchantPilot AI - Environment Configuration

# Application
APP_NAME="MerchantPilot AI"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database (Default is local SQLite, seamlessly swappable to PostgreSQL)
DATABASE_URL="sqlite:///./merchantpilot.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/merchantpilot_db"

# Razorpay Test Mode Credentials
# Get your test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# Gemini API Key (Optional - Resilient Fallback deterministic agent active if not set)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=""

# Merchant Policy Defaults
DEFAULT_MAX_DISCOUNT_PERCENTAGE=10.0
DEFAULT_MAX_DISCOUNT_AMOUNT=6000.0
DEFAULT_MAX_TRANSACTION_AMOUNT=100000.0
